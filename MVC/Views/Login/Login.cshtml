@model MVC.Models.UserModel
@{
    ViewBag.Title = "Login";
}

<h2>Login</h2>
<div>
    @Html.ValidationMessage("LoginFailed")
    @using (Html.BeginForm("Login", "Login"))
    {
        <table>
            <tr>
                <td>User Name</td>
                <td>
                    @Html.TextBoxFor(m => m.UserName);
                </td>
            </tr>
            <tr>
                <td>Password</td>
                <td> @Html.TextBoxFor(m => m.UserPassword);</td>
            </tr>
            <tr>
                <td colspan="2">

                    <input type="submit" value="Login" />
                </td>
            </tr>
        </table>
    }

</div>

